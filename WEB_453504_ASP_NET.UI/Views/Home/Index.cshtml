@{
    ViewBag.Title = "Index";
}
<main class="container mt-4 mb-5">
    <h1 class="display-5">Лабораторная работа 1</h1>

    <h3 class="mt-4">Список</h3>
    <ol type="A">
        <li>элемент 1 списка</li>
        <li>элемент 2 списка</li>
    </ol>

    <hr />

    <h3 class="mt-4 mb-3">Форма</h3>

    <form method="post" class="login-form" novalidate>
        <div class="row mb-3">
            <div class="col-sm-2"></div>
            <div class="col-sm-10">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chk1" name="chk1">
                    <label class="form-check-label" for="chk1">Чек-бокс 1</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chk2" name="chk2">
                    <label class="form-check-label" for="chk2">Чек-бокс 2</label>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-2"></div>
            <div class="col-sm-10">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="radios" id="radio1" value="1" checked>
                    <label class="form-check-label" for="radio1">Радио-1</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="radios" id="radio2" value="2">
                    <label class="form-check-label" for="radio2">Радио-2</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="radios" id="radio3" value="3">
                    <label class="form-check-label" for="radio3">Радио-3</label>
                </div>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label for="login" class="col-sm-2 col-form-label">Логин:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="login" name="login" placeholder="Введите имя" required>
                <div class="invalid-feedback">Введите логин.</div>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label for="password" class="col-sm-2 col-form-label">Пароль:</label>
            <div class="col-sm-10">
                <input type="password" class="form-control" id="password" name="password" placeholder="Введите пароль" required>
                <div class="invalid-feedback">Введите пароль.</div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-2"></div>
            <div class="col-sm-10">
                <button type="submit" class="btn btn-info">Отправить</button>
            </div>
        </div>
    </form>
</main>