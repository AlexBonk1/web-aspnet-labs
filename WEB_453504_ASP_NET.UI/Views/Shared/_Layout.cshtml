<!DOCTYPE html>
<html lang="en">

@{
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/open-iconic/font/css/open-iconic-bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    
    <link rel="stylesheet" href="~/WebLabs_BSUIR_V02.styles.css" asp-append-
          version="true" />
</head>
<body>
    <header>
        <div class="container">
            <nav class="navbar bg-dark navbar-expand-md border-bottom border-body"
                 data-bs-theme="dark">
                <partial name="_MenuPartial" />
                <partial name="_UserInfoPartial" />
            </nav>
        </div>
    </header>
    <main class="container mt-4 mb-5">
    @RenderBody()    
    </main>
    <footer>
       <partial name="_FooterPartial" />
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
