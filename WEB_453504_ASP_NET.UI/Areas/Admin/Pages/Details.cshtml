        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MusicalInstrument.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MusicalInstrument.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MusicalInstrument.WeightKg)
        </dt>
        <dd class="col-sm-10">
