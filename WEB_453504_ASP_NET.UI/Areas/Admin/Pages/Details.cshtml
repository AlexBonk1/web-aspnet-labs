        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MusicalInstrument.ImageUrl)
                <img asp-image-name=@Model.MusicalInstrument.ImageUrl  onerror="this.onerror=null; this.src='/images/no-image.jpg';" width="400" />
