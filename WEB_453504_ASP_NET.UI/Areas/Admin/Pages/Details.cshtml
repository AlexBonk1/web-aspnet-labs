        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MusicalInstrument.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MusicalInstrument.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MusicalInstrument.Description)
        </dt>
        <dd class="col-sm-10">
