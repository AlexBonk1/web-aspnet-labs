@page
@model WEB_453504_ASP_NET.UI.Areas_Admin_Pages.DetailsModel


@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>MusicalInstrument</h4>
    <hr />
