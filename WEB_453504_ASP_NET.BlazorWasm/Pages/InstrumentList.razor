@page "/items"
@using Microsoft.AspNetCore.Authorization
@using WEB_453504_ASP_NET.Domain.Entities
@attribute [Authorize]
<PageTitle>Instruments</PageTitle>

<h3>Меню дня</h3>
<CategorySelector />
<InstrumentListComp OnSelected="OnInstrumentSelected" />
<InstrumentDetails SelectedInstrument="SelectedInstrument" />

@code {
    [Inject]
    public IDataService DataService { get; set; } = default!;

    MusicalInstrument? SelectedInstrument { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await DataService.GetInstrumentsListAsync(1);
    }

    void OnInstrumentSelected(int id)
    {
        SelectedInstrument = DataService.Instruments.FirstOrDefault(d => d.Id == id);
    }
}

