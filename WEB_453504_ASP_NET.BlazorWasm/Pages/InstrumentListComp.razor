@using WEB_453504_ASP_NET.BlazorWasm.Services
@using WEB_453504_ASP_NET.Domain.Entities;
@inject NavigationManager Navigation
@inject IDataService DataService
@implements IDisposable

<AuthorizeView Context="authContext">
    <Authorized>
        <QuickGrid Items="@DataService.Instruments.AsQueryable()" @key="DataService.Instruments" Class="table table-striped">
            <PropertyColumn Property="@(d => d.Name)" Title="Название" Sortable="true" />
            <PropertyColumn Property="@(d => d.Description)" Title="Описание" />
            <TemplateColumn Title="Действие" Context="item">
                <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => OnSelected.InvokeAsync(item.Id))">
                    Выбрать
                </button>
            </TemplateColumn>
        </QuickGrid>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(DataService.CurrentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(DataService.CurrentPage - 1)">&laquo;</button>
                </li>
                @for (int i = 1; i <= DataService.TotalPages; i++)
                {
                    var pageNumber = i;
                    <li class="page-item @(DataService.CurrentPage == pageNumber ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                    </li>
                }
                <li class="page-item @(DataService.CurrentPage >= DataService.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(DataService.CurrentPage + 1)">&raquo;</button>
                </li>
            </ul>
        </nav>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning text-center mt-4" role="alert">
            <h4>Log in to view data</h4>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public EventCallback<int> OnSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DataService.DataLoaded += StateHasChanged;
        await DataService.GetInstrumentsListAsync(1);
    }

    private async Task ChangePage(int pageNo)
    {
        if (pageNo >= 1 && pageNo <= DataService.TotalPages)
        {
            await DataService.GetInstrumentsListAsync(pageNo, DataService.SelectedCategory?.NormalizedName);
        }
    }

    private void ShowDetails(int id) 
    {
        Navigation.NavigateTo($"/instrument/{id}");
    }

    public void Dispose()
    {
        DataService.DataLoaded -= StateHasChanged;
    }
}
